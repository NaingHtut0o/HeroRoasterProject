generator client {
  provider = "prisma-client-js"
  output   = "../src/generated"
}

datasource db {
  provider = "sqlite"
}

model Character {
  id        String   @id @default(cuid())
  name      String
  role      String
  element   String
  bio       String
  hp        Int
  attack    Int
  defense   Int
  speed     Int
  color     String
  imageUrl  String
  createdAt DateTime @default(now())
}
